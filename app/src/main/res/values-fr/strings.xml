    <!-- Onboarding Page 6: Done -->
    <string name="onboarding_done_title">C\'est prêt !</string>
    <string name="onboarding_done_body">Benchy est calibré et prêt à tester votre matériel, surveiller la santé de l\'appareil et protéger vos applications.</string>

    <!-- Dashboard & Test My Phone -->
    <string name="dashboard_hero_title">Tester mon téléphone</string>
    <string name="dashboard_hero_subtitle">Analyse complète de la vitesse matérielle, de la stabilité thermique et des jeux.</string>
    <string name="dashboard_run_test_cta">Lancer le test</string>
    <string name="dashboard_last_score_label">Dernier score global</string>
    <string name="dashboard_no_runs_yet">Aucun test effectué — appuyez sur Tester mon téléphone pour établir votre référence.</string>
    <string name="test_my_phone_intro_title">À propos de Tester mon téléphone</string>
    <string name="test_my_phone_intro_message">Ceci est Tester mon téléphone, il évalue votre téléphone selon le CPU, le GPU, le STOCKAGE et l\'analyse antivirus des applications. Vous pouvez faire une analyse rapide de 30 secondes (sans analyse antivirus), ou une analyse de 2 heures offrant tout le test rapide plus la détection d\'activités malveillantes. L\'analyse de 2 heures est recommandée car elle est plus précise.</string>

    <!-- Scan Mode Selector -->
    <string name="scan_mode_sheet_title">Choisir le mode d\'analyse</string>
    <string name="scan_quick_title">Analyse rapide (30 secondes)</string>
    <string name="scan_quick_desc">Contrôle rapide CPU, GPU, RAM, Stockage et Thermique. N\'inclut PAS d\'analyse antivirus des applications, car inspecter les paquets en 30 secondes serait très imprécis.</string>
    <string name="scan_long_title">Analyse longue (2 heures — Recommandée)</string>
    <string name="scan_long_desc">Tout le test rapide plus un profilage thermique prolongé et une analyse complète des applications pour activités malveillantes et permissions dangereuses via un service persistant.</string>
    <string name="battery_opt_title">Éviter l\'interruption en arrière-plan</string>
    <string name="battery_opt_long_scan_body">Pour éviter que l\'économiseur de batterie ne coupe l\'analyse de 2 heures, Benchy demande l\'exemption d\'optimisation de batterie.</string>
    <string name="battery_opt_autoscan_body">Pour garantir la fiabilité de l\'antivirus quotidien automatique, Benchy recommande d\'autoriser l\'exemption d\'optimisation de batterie.</string>
    <string name="battery_opt_allow">Autoriser l\'exemption</string>
    <string name="battery_opt_continue_anyway">Continuer quand même</string>

