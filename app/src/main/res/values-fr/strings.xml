    <!-- Sub-Ratings & Reviews -->
    <string name="subrating_2d_gaming">Jeux 2D</string>
    <string name="subrating_3d_gaming">Jeux 3D</string>
    <string name="subrating_battery_temp">Temp. batterie</string>
    <string name="subrating_multitasking">Multitâche</string>
    <string name="review_tier_critical">Avertissement critique de performance : Limitation thermique sévère ou goulot matériel détecté. Les apps peuvent ralentir et la batterie chauffe. Laissez refroidir l\'appareil.</string>
    <string name="review_tier_drag">Ralentissement modéré : Votre téléphone commence à faiblir sous charge. Libérez de l\'espace de stockage ou fermez des tâches en arrière-plan.</string>
    <string name="review_tier_good">Bon et stable : Votre téléphone fonctionne fluidement au quotidien, pour les jeux 2D et le multitâche. Les températures sont normales.</string>
    <string name="review_tier_peak">Performance optimale : Excellent état ! Votre matériel fonctionne à plein régime avec une grande efficacité thermique. Parfait pour les jeux 3D.</string>

