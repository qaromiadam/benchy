    <!-- Onboarding Page 2: Welcome -->
    <string name="onboarding_welcome_title">Bienvenue sur Benchy</string>
    <string name="onboarding_welcome_body">Benchy garde votre téléphone rapide, sain et sécurisé sans aucune publicité, sans suivi, et avec de vrais diagnostics natifs C++.</string>
    <string name="onboarding_welcome_pill_speed">Vitesse native</string>
    <string name="onboarding_welcome_pill_health">Santé appareil</string>
    <string name="onboarding_welcome_pill_security">Sécurité apps</string>

    <!-- Onboarding Page 3: Mode Selection -->
    <string name="onboarding_mode_title">Sélectionnez votre mode</string>
    <string name="onboarding_mode_subtitle">Choisissez le niveau de détail des diagnostics à afficher.</string>
    <string name="mode_user_friendly_title">Mode Simplifié</string>
    <string name="mode_user_friendly_desc">Scores clairs, notes de santé de 1 à 10 et tests en un geste.</string>
    <string name="mode_techy_title">Mode Techy</string>
    <string name="mode_techy_desc">Télémétrie C++ brute, fréquences CPU, IOPS 4K et graphiques de stress.</string>
    <string name="onboarding_mode_helper">Ne vous inquiétez pas de faire le choix parfait maintenant — votre mode peut être modifié plus tard dans les Paramètres.</string>

    <!-- Onboarding Page 4: Basic Permissions -->
    <string name="onboarding_perms_title">Autorisations nécessaires</string>
    <string name="onboarding_perms_subtitle">Uniquement les autorisations de base — aucune dérogation batterie en arrière-plan requise ici.</string>
    <string name="onboarding_perm_notif_title">Notifications d\'analyse et d\'alerte</string>
    <string name="onboarding_perm_notif_desc">Permet à Benchy de jouer les alertes Ding-Ding ou Dong-Dong lorsque les tests ou analyses se terminent.</string>
    <string name="onboarding_perm_pkg_title">Vérifications matérielles et stockage</string>
    <string name="onboarding_perm_pkg_desc">Lit les fréquences CPU, la capacité RAM, la température batterie et les manifestes d\'applications.</string>
    <string name="onboarding_perm_granted">Accordée</string>
    <string name="onboarding_perm_needed">Appuyer pour autoriser</string>
    <string name="onboarding_perm_auto_active">Actif automatiquement</string>

