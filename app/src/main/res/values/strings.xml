    <!-- Dashboard & Test My Phone -->
    <string name="dashboard_hero_title">Test My Phone</string>
    <string name="dashboard_hero_subtitle">Full hardware speed, thermal stability, and gaming readiness check.</string>
    <string name="dashboard_run_test_cta">Start Phone Test</string>
    <string name="dashboard_last_score_label">Latest Overall Score</string>
    <string name="dashboard_no_runs_yet">No scan run yet — tap Test My Phone to establish your device baseline.</string>
    <string name="test_my_phone_intro_title">About Test My Phone</string>
    <string name="test_my_phone_intro_message">This is test my phone, tests your phone based on CPU, GPU, STORAGE, and app scan for viruses, you can do a quick 30 second scan, but won\'t have app scanning, or 2 hour scan, offers everything in quick scan and app scan for malicious activity, 2 hour scan is recommended because its more accurate</string>

    <!-- Scan Mode Selector -->
    <string name="scan_mode_sheet_title">Choose Scan Mode</string>
    <string name="scan_quick_title">Quick Scan (30 Seconds)</string>
    <string name="scan_quick_desc">Rapid CPU, GPU, RAM, Storage, and Thermal check. Does NOT include an app virus scan, because performing package inspections in 30 seconds would be very inaccurate and rush the system.</string>
    <string name="scan_long_title">Long Scan (2 Hours — Recommended)</string>
    <string name="scan_long_desc">Everything in Quick Scan plus deep sustained thermal profiling and full app scan for malicious activity, dangerous permissions, and unsafe code via a persistent foreground service.</string>
    <string name="battery_opt_title">Prevent Background Interruption</string>
    <string name="battery_opt_long_scan_body">To stop aggressive OEM battery savers from killing the 2-hour scan mid-run, Benchy asks for background battery optimization exemption.</string>
    <string name="battery_opt_autoscan_body">To keep daily automated antivirus scans reliable while your phone sleeps, Benchy recommends allowing background battery optimization exemption.</string>
    <string name="battery_opt_allow">Allow Exemption</string>
    <string name="battery_opt_continue_anyway">Continue Anyway</string>

